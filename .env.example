# Code My Resume (CMR) Environment Variables
# Copy to .env and fill only the keys you use. NEVER commit .env to git.

# Preferred LLM provider: gemini | ollama | openai | anthropic
CMR_LLM_PROVIDER=gemini

# Google Gemini (default cloud provider via google-genai SDK)
GEMINI_API_KEY=

# Local 100% offline inference via Ollama (default daemon URL)
OLLAMA_BASE_URL=http://localhost:11434

# Optional third-party providers (requires pip install -e ".[llms]" or REST adapter)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional diagnostics: DEBUG | INFO | WARNING | ERROR
CMR_LOG_LEVEL=INFO
